<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Replace an inherited GLB mapping without duplicate MIME entry errors. -->
      <remove fileExtension=".glb" />
      <mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
    </staticContent>
  </system.webServer>
</configuration>
